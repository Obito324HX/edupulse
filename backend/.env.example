# Copy this file to .env and fill in real values. Never commit .env itself —
# it's already in .gitignore, but check `git status` before committing if
# you ever rename or restructure this file.

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Your database connection string (e.g. from Render/Supabase/Railway/etc.)
DATABASE_URL=

# Mail settings, if using email notifications
MAIL_SERVER=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=
