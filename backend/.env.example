# Copy this file to .env and fill in real values. Never commit .env itself —
# it's already in .gitignore, but check `git status` before committing if
# you ever rename or restructure this file.

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Your database connection string (e.g. from Render/Supabase/Railway/etc.)
DATABASE_URL=

# Email is sent via Resend's HTTPS API (not SMTP -- Render blocks raw
# outbound SMTP on free instances). Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Only send from a verified domain once you own one. Until then, leave
# blank to use Resend's shared test sender, which only delivers to the
# email address on your own Resend account.
RESEND_FROM_EMAIL=

# Base URL of the deployed frontend, used to build links in password reset
# emails. Defaults to the live Vercel deployment if left blank.
FRONTEND_URL=
